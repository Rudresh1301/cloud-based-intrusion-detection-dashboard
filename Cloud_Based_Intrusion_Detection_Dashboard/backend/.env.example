# ==========================================
# CLOUD-BASED INTRUSION DETECTION DASHBOARD
# BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

# Application Settings
APP_NAME="Cloud-Based Intrusion Detection Dashboard"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# CORS Origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,https://your-frontend.vercel.app"

# Database Configuration
# Set to 'firebase' for cloud production, or 'sqlite' for local development fallback
DATABASE_TYPE="sqlite"
SQLITE_DB_PATH="data/local_soc.db"

# Firebase Cloud Configuration
# Provide path to your service account JSON file downloaded from Firebase Console
# e.g., config/firebase-credentials.json
FIREBASE_CREDENTIALS_PATH=""
FIREBASE_PROJECT_ID=""
FIREBASE_STORAGE_BUCKET=""

# Threat Detection Heuristics Thresholds
BRUTE_FORCE_THRESHOLD=5
BRUTE_FORCE_CRITICAL=10
HIGH_VOLUME_THRESHOLD=50
TIME_WINDOW_MINUTES=10

# Machine Learning Anomaly Detection Configuration
ML_CONTAMINATION=0.1
ML_MIN_SAMPLES=10
ML_RANDOM_STATE=42

# JWT / Security Settings
SECRET_KEY="cloud-soc-intrusion-detection-production-secret-key-change-in-prod"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
